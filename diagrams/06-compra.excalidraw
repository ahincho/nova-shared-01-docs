      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 629772494,
      "version": 3,
      "versionNonce": 140762258,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791003344610,
      "link": null,
      "locked": false,
      "text": "Si un paso falla, el BFF deshace los anteriores, en orden inverso\n\nsin stock en 1: 409 OUT_OF_STOCK, y no hay nada que deshacer\npago rechazado en 3: cancela el pedido y libera la reserva\nfalla en 4 o 5: reembolsa, cancela y libera\nuna reserva sin confirmar vence sola a los diez minutos",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "comp",
      "originalText": "Si un paso falla, el BFF deshace los anteriores, en orden inverso\n\nsin stock en 1: 409 OUT_OF_STOCK, y no hay nada que deshacer\npago rechazado en 3: cancela el pedido y libera la reserva\nfalla en 4 o 5: reembolsa, cancela y libera\nuna reserva sin confirmar vence sola a los diez minutos",
      "autoResize": true,
      "lineHeight": 1.25
    },
