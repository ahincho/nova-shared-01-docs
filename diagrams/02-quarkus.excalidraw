    {
      "id": "L3IysTz9iEI3t-p0UlQvx",
      "type": "text",
      "x": 261.01123046875,
      "y": 798.75,
      "width": 757.9775390625,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#7048e8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
