    {
      "id": "fpHckVGM2FTCctX8Z-_9h",
      "type": "text",
      "x": 173.87841796875,
      "y": 358.75,
      "width": 372.2431640625,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
