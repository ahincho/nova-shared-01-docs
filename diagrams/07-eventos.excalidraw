    {
      "id": "pQAc8P_Q3oZh5Ljgd8BSM",
      "type": "text",
      "x": 867.8857421875,
      "y": 659.375,
      "width": 564.228515625,
      "height": 131.25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
