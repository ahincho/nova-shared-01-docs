      "versionNonce": 1930077872,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791003384674,
      "link": null,
      "locked": false,
      "text": "Los tres eventos de pedidos, sin el cliente\n\norder.created.v1 al crear · order.confirmed.v1 al confirmar · order.cancelled.v1 al cancelar\nrepetir una confirmación o una cancelación no escribe otro evento",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "types",
      "originalText": "Los tres eventos de pedidos, sin el cliente\n\norder.created.v1 al crear · order.confirmed.v1 al confirmar · order.cancelled.v1 al cancelar\nrepetir una confirmación o una cancelación no escribe otro evento",
      "autoResize": true,
      "lineHeight": 1.25
    },
